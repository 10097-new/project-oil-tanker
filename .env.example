# 复制为 .env 后填入密钥。三种写法任选其一。

DEEPSEEK_API_KEY=

# DIGEST_API_KEY=
# DIGEST_BASE_URL=https://api.openai.com
# DIGEST_MODEL=gpt-4o-mini

# DASHSCOPE_API_KEY=
# DIGEST_MODEL=qwen-plus

# 微信公众号正文（WeWe RSS，与网页采集分开）
# WECHAT_RSS_BASE=http://127.0.0.1:4000
# 须与 docker-compose.wechat.yml 里 AUTH_CODE 一致
# WECHAT_AUTH_CODE=123567
# 连续更新两个公众号的间隔秒数，过短容易进小黑屋
# WECHAT_UPDATE_DELAY_SEC=20

# 智能推送（可选）。重大突发事件会走这些渠道，并写入 briefs/library/alerts.json
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# NOTIFY_EMAIL_TO=leaders@example.com
# WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=
# NOTIFY_FOCUS_TAGS=地缘局势,同行动态,油轮基本面
